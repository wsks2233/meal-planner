# 数据库连接串
# 开发默认 SQLite（无需配置）：sqlite:///{BASE_DIR}/meal.db
# 生产可切换 PostgreSQL：
# DATABASE_URL=postgresql+psycopg2://meal:meal@localhost:5432/meal
DATABASE_URL=

# 上传目录（食谱成品图）。Docker 中建议指向持久卷，如 /data/uploads
UPLOAD_DIR=

# 临期判定阈值（剩余保质天数 <= 该值视为"临期"）
EXPIRING_SOON_DAYS=3

# 菜价历史回填天数（首次启动生成演示数据）
PRICE_BACKFILL_DAYS=90

# 推荐算法模拟退火迭代次数（越大越优、越慢）
OPTIMIZER_ITERATIONS=400
